# =============================================================================
# NDR Platform - environment template
# Copy to .env and adjust BEFORE ./install.sh. Every var below has a safe
# default; only the ones marked REQUIRED usually need edits.
# v0.16.0 - all vars v0.14.0-v0.15.0 plus: EXPORT_MAX_ROWS (R6),
#   RULE_STATS_REFRESH_MIN (R14/15), ARKIME_PROXY_SECRET/PUBLIC_BASE (R13
#   SSO bake), DETECT_BRUTEFORCE* (R1/3), GAMBLING_* (R18), GEOIP_* (R12)
# =============================================================================

# ---------- core ----------
SENSOR_ID=sensor-01
TZ=Asia/Jakarta

# REQUIRED: SPAN/mirror interface on this host (checked by sensor-precheck.sh)
CAPTURE_IFACE=enp6s19

# Data root created by install.sh (OpenSearch/Postgres/PCAP layout)
NDR_DATA_ROOT=/var/lib/ndr

# ---------- OpenSearch ----------
# A4 (report 0.15.0): pin the image explicitly. NOTE: OpenSearch 2.20 was
# never released - the 2.x line ends at 2.19.x; the newest 2.x patch is
# 2.19.6 (in-place upgrade from 2.19.2, carries accumulated Lucene/indexing
# bug fixes). 3.x is a major line - evaluate plugins/tools separately.
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.19.6
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_PORT=9200
RETENTION_DAYS=60

# ---------- Postgres ----------
# A1: install.sh detects the postgres uid/gid FROM THIS IMAGE
# (postgres:16-alpine = uid 70; Debian images = 999). Do not chown by hand.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=ndr
POSTGRES_USER=ndr
# CHANGE ME: generate with `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me-strong
POSTGRES_PORT=5432

# ---------- API ----------
# CHANGE ME: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-32-bytes-min
ACCESS_TOKEN_MINUTES=30
ADMIN_USERNAME=admin
# CHANGE ME (min 10 chars); forced change on first login
ADMIN_PASSWORD=change-me-min-10-chars
LOGIN_MAX_FAILED=5
LOGIN_LOCKOUT_MINUTES=15
TLS_ENABLED=0

# v0.13.0: set to 1 ONLY when the API sits behind nginx/TLS gateway -
# then X-Forwarded-For is trusted for rate-limit + audit client_ip.
# With the default (0) a spoofed XFF header cannot poison audit records.
TRUST_PROXY=0

# PCAP evidence
PCAP_DIR=/var/lib/ndr/pcap
PCAP_EXPORT_TTL_MINUTES=60
PCAP_EXPORT_MAX_FILES=5
PCAP_EXPORT_MAX_BYTES=2000000000
PCAP_SESSION_BUFFER_MINUTES=5

# v0.16.0 requirement 6: batas baris export alert per permintaan (xlsx/csv)
EXPORT_MAX_ROWS=50000
# v0.16.0 requirement 14+15: interval refresh statistik hit per rule (menit)
RULE_STATS_REFRESH_MIN=15

# v0.16.0 requirement 13 (BAKED): SSO NDR -> Arkime viewer.
# Generate: openssl rand -hex 24. HARUS SAMA di kedua layanan (api+arkime) -
# docker-compose meneruskan var ini ke keduanya. KOSONG = SSO off
# (viewer kembali ke form-auth, proxy API membalas 503 secara jujur).
# Rotasi: set nilai baru di sini + `docker compose up -d` (api+arkime
# restart), sesi viewer lama otomatis tidak valid.
ARKIME_PROXY_SECRET=
# Base path publik viewer lewat UI proxy (default cocok dengan UI
# next.config rewrites). Trailing slash dirender otomatis di viewer.
ARKIME_PUBLIC_BASE=/backend/api/arkime

# ---------- pipeline ----------
PIPELINE_SOURCES=suricata,zeek
# v0.13.0: files.log is mapped so FileTransfer sees Zeek data
PIPELINE_ZEEK_LOGS=conn,dns,http,tls,files
PIPELINE_SURICATA_TYPES=alert,dns,http,tls,fileinfo,flow
PIPELINE_HEALTH_INTERVAL=30
PIPELINE_RAW_RETENTION_HOURS=72

# A3 (report 0.15.0) - sink/bulk sizing (see docs/SIZING-8c-24GB-3TB.md and
# scripts/poc/sink_benchmark.sh):
#   PIPELINE_BULK_MAX_ITEMS     docs per bulk request. 10-20 is VERY SMALL
#     for this workload (many tiny requests -> many tiny Lucene segments +
#     HTTP overhead). 200 is live-proven on the reference VM (~302 EPS,
#     queue <= 30, single shard); 500 is the code default and fine on
#     healthy hardware. Start at 200.
#   PIPELINE_BULK_FLUSH_SECONDS max seconds to wait before flushing a
#     partial batch (5s keeps alert latency low without spamming tiny
#     bulks; do not go below 1s).
#   PIPELINE_BULK_MAX_RETRIES   app-level attempts for retryable failures
#     (429/5xx/network). Timeouts are NEVER retried (anti-wedge, A2).
PIPELINE_BULK_MAX_ITEMS=200
PIPELINE_BULK_FLUSH_SECONDS=5
PIPELINE_BULK_MAX_RETRIES=8

# Detection tuning (all optional)
DETECT_PORTSCAN_UNIQUE_PORTS=100
DETECT_PORTSCAN_UNIQUE_HOSTS=50
DETECT_PORTSCAN_WINDOW_MIN=10
DETECT_NXDOMAIN_MIN_COUNT=20
DETECT_NXDOMAIN_WINDOW_MIN=10
DETECT_NXDOMAIN_RATIO=0.5
# v0.13.0: dedicated beaconing window (no more 60-minute floor)
DETECT_BEACON_MIN_CONNECTIONS=20
DETECT_BEACON_INTERVAL_MIN_SEC=10
DETECT_BEACON_INTERVAL_MAX_SEC=3600
DETECT_BEACON_JITTER_MAX=0.2
DETECT_BEACON_WINDOW_MIN=10
DETECT_ALERT_WINDOW_MIN=10
DETECT_WINDOW_MIN=10
DETECT_FILE_MIN_BYTES=5000000
DETECT_DGA_MIN_UNIQUE=10
DETECT_DGA_ENTROPY_MIN=3.5
# v0.12.9: extra DGA allowlist suffixes, comma-separated
DETECT_DGA_ALLOWLIST=
DETECT_LATERAL_PORTS=22,135,139,445,3389,5985,5986
DETECT_LATERAL_MIN_CONNS=20
DETECT_LATERAL_CROSS_ZONE_MIN=5
DETECT_EXFIL_MIN_BYTES=100000000

# v0.16.0 requirement 1+3: auth brute force (canary -> kill switch)
DETECT_BRUTEFORCE=1
DETECT_BRUTEFORCE_MIN_FAILURES=20
DETECT_BRUTEFORCE_WINDOW_MIN=10

# v0.16.0 requirement 18: watchlist Judi Online (keyword + domain file).
# Sinkronkan GAMBLING_KEYWORDS juga dibaca API untuk display.
GAMBLING_KEYWORDS=judi,slot,togel,sbobet,casino,poker,baccarat,parlay,judol
GAMBLING_DOMAINS_FILE=
DETECT_GAMBLING=1
DETECT_GAMBLING_MIN_HITS=3
DETECT_GAMBLING_WINDOW_MIN=10

# v0.16.0 requirement 12: GeoIP + ASN + Org (opsional; kosong = off).
# GEOIP_MMDB_PATH=GeoLite2-City.mmdb (bisa satu file City+ASN gabungan
# dari vendor DBIP/MaxMind); GEOIP_JSON_PATH=sidecar CIDR opsional.
GEOIP_MMDB_PATH=
GEOIP_JSON_PATH=

# Threat intelligence
TI_ENABLED=1
TI_JOB_POLL_SECONDS=5
TI_RELOAD_SECONDS=60
TI_HTTP_TIMEOUT=30
TI_MAX_FEED_BYTES=26214400
TI_VERIFY_TLS=1
TI_AUTO_SCHEDULE=1
TI_MAX_IOCS_LOADED=200000
DETECT_IOC_MATCH=1
DETECT_IOC_WINDOW_MIN=10

# Attack reconstruction
RECON_ENABLED=1
RECON_MAX_GAP_SECONDS=7200
RECON_LOOKBACK_HOURS=24
RECON_MAX_ACTIVE_STORIES=500
RECON_MAX_EVIDENCE=400
RECON_PERSIST_SECONDS=10

# ---------- sensors (profile: sensor) ----------
# Suricata hands socket+rules to this API uid (default 10002)
SURICATA_API_UID=10002
ZEEK_IMAGE=

# Arkime rolling free-space eviction (GB)
ARKIME_FREE_SPACE_G=40
